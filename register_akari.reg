Windows Registry Editor Version 5.00


[HKEY_CLASSES_ROOT\.akari]
@="AkariScriptFile"


[HKEY_CLASSES_ROOT\AkariScriptFile]
@="Fichier Source Akari"


[HKEY_CLASSES_ROOT\AkariScriptFile\DefaultIcon]
@="%USERPROFILE%\\Desktop\\travail\\Akari\\Akari.ico"


[HKEY_CLASSES_ROOT\AkariScriptFile\shell\open\command]
@="notepad.exe \"%1\""