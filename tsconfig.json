{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"] 
  },
  "include": [
    "src/**/*",
    "cli/**/*",
    "tests/**/*",
    "index.ts",
    "tests.ts"
  ],
  "exclude": ["node_modules", "dist", "examples", "std_akari"]
}