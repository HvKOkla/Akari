# Math Utilities for Akari

def clamp(value, min, max):
    if value < min:
        return min
    end
    if value > max:
        return max
    end
    return value
end

def lerp(a, b, t):
    return a + (b - a) * t
end

def distance(x1, y1, x2, y2):
    let dx = x2 - x1
    let dy = y2 - y1
    return sqrt(dx * dx + dy * dy)
end