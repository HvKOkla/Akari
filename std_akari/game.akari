# Game Utilities for Akari

def new_entity(name, hp, attack):
    return {
        "name": name,
        "hp": hp,
        "max_hp": hp,
        "attack": attack,
        "is_alive": true
    }
end

def take_damage(entity, amount):
    entity.hp = entity.hp - amount
    if entity.hp <= 0:
        entity.hp = 0
        entity.is_alive = false
        say(entity.name + " has died.")
    else:
        say(entity.name + " takes " + toText(amount) + " damage. (" + toText(entity.hp) + " HP left)")
    end
end

def heal(entity, amount):
    if entity.is_alive == false:
        return
    end
    entity.hp = entity.hp + amount
    if entity.hp > entity.max_hp:
        entity.hp = entity.max_hp
    end
    say(entity.name + " heals for " + toText(amount) + ".")
end