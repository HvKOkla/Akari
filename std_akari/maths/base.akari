# =============================================================
# Akari Standard Library - maths/base
# Basic math functions.
# 100% pure Akari: no runtime dependency.
# =============================================================

# --- Square root (uses the runtime) ---
def sqrt(x):
    return __rt_math_sqrt(x)
end

# --- Absolute value ---
def positive(n):
    if n < 0:
        return 0 - n
    end
    return n
end

# --- Clamp ---
def clamp(val, low, high):
    if val < low:
        return low
    end
    if val > high:
        return high
    end
    return val
end

# --- Maximum ---
def max(a, b):
    if a > b:
        return a
    end
    return b
end

# --- Minimum ---
def min(a, b):
    if a < b:
        return a
    end
    return b
end

# --- Round ---
def round(n):
    let reste = n % 1
    if reste >= 0.5:
        return n + (1 - reste)
    end
    if reste <= -0.5:
        return n - (1 + reste)
    end
    return n - reste
end

# --- Sign ---
def sign(n):
    if n < 0:
        return -1
    end
    if n > 0:
        return 1
    end
    return 0
end

# --- Percentage ---
def percent(val, total):
    return (val / 100) * total
end

# --- Linear interpolation ---
def lerp(a, b, t):
    return a + (b - a) * t
end

# --- Smooth interpolation ---
def smoothstep(t):
    mut x = t
    if x < 0:
        x = 0
    end
    if x > 1:
        x = 1
    end
    return x * x * (3 - 2 * x)
end

# --- Remapping ---
def map(val, inMin, inMax, outMin, outMax):
    let t = (val - inMin) / (inMax - inMin)
    return outMin + (outMax - outMin) * t
end

# --- Approximate comparison ---
def approx(a, b, epsilon):
    return positive(a - b) < epsilon
end

# --- Bound 0-1 ---
def unit(x):
    return clamp(x, 0, 1)
end

# --- Square ---
def square(x):
    return x * x
end

# --- Cube ---
def cube(x):
    return x * x * x
end

# --- Even / odd ---
def isEven(n):
    return n % 2 == 0
end

def isOdd(n):
    return n % 2 != 0
end

# --- Multiple ---
def isMultiple(n, k):
    return n % k == 0
end

# --- Integer power ---
def intPow(base, exp):
    mut result = 1
    mut i = 0
    while i < exp:
        result = result * base
        i = i + 1
    end
    return result
end

# --- GCD ---
def gcd(a, b):
    mut x = positive(a)
    mut y = positive(b)
    mut tmp = 0
    while y != 0:
        tmp = y
        y = x % y
        x = tmp
    end
    return x
end

# --- LCM ---
def lcm(a, b):
    if a == 0:
        return 0
    end
    if b == 0:
        return 0
    end
    return positive(a * b) / gcd(a, b)
end

# --- Factorial ---
def factorial(n):
    if n <= 1:
        return 1
    end
    mut result = 1
    mut i = 2
    while i <= n:
        result = result * i
        i = i + 1
    end
    return result
end

# --- Fibonacci ---
def fib(n):
    if n <= 0:
        return 0
    end
    if n == 1:
        return 1
    end
    mut a = 0
    mut b = 1
    mut tmp = 0
    mut i = 2
    while i <= n:
        tmp = a + b
        a = b
        b = tmp
        i = i + 1
    end
    return b
end

# --- Average ---
def average(a, b):
    return (a + b) / 2
end

# --- PI constant ---
def PI():
    return 3.141592653589793
end

# --- Degree <-> Radian conversion ---
def degToRad(deg):
    return deg * PI() / 180
end

def radToDeg(rad):
    return rad * 180 / PI()
end
