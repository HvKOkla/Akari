# =============================================================
# Akari Standard Library - maths/base
# Fonctions mathematiques de base.
# 100% Akari pur : aucune dependance au runtime.
# =============================================================

# --- Racine carree (utilise le runtime) ---
def sqrt(x):
    return __rt_math_sqrt(x)
end
# --- Valeur absolue ---
def positive(n):
    if n < 0:
        return 0 - n
    end
    return n
end


# --- Encadrement ---
def clamp(val, low, high):
    if val < low:
        return low
    end
    if val > high:
        return high
    end
    return val
end


# --- Maximum ---
def max(a, b):
    if a > b:
        return a
    end
    return b
end


# --- Minimum ---
def min(a, b):
    if a < b:
        return a
    end
    return b
end


# --- Arrondi ---
def round(n):
    let reste = n % 1
    if reste >= 0.5:
        return n + (1 - reste)
    end
    if reste <= -0.5:
        return n - (1 + reste)
    end
    return n - reste
end


# --- Signe ---
def sign(n):
    if n < 0:
        return -1
    end
    if n > 0:
        return 1
    end
    return 0
end


# --- Pourcentage ---
def percent(val, total):
    return (val / 100) * total
end


# --- Interpolation lineaire ---
def lerp(a, b, t):
    return a + (b - a) * t
end


# --- Interpolation lisse ---
def smoothstep(t):
    if t < 0:
        t = 0
    end
    if t > 1:
        t = 1
    end
    return t * t * (3 - 2 * t)
end


# --- Re-mappage ---
def map(val, inMin, inMax, outMin, outMax):
    let t = (val - inMin) / (inMax - inMin)
    return outMin + (outMax - outMin) * t
end


# --- Comparaison approximative ---
def approx(a, b, epsilon):
    return positive(a - b) < epsilon
end


# --- Borne 0-1 ---
def unit(x):
    return clamp(x, 0, 1)
end


# --- Carre ---
def square(x):
    return x * x
end


# --- Cube ---
def cube(x):
    return x * x * x
end


# --- Pair / impair ---
def isEven(n):
    return n % 2 == 0
end

def isOdd(n):
    return n % 2 != 0
end


# --- Multiple ---
def isMultiple(n, k):
    return n % k == 0
end


# --- Puissance entiere ---
def intPow(base, exp):
    mut result = 1
    mut i = 0
    while i < exp:
        result = result * base
        i = i + 1
    end
    return result
end


# --- PGCD ---
def gcd(a, b):
    mut x = positive(a)
    mut y = positive(b)
    mut tmp = 0
    while y != 0:
        tmp = y
        y = x % y
        x = tmp
    end
    return x
end


# --- PPCM ---
def lcm(a, b):
    if a == 0:
        return 0
    end
    if b == 0:
        return 0
    end
    return positive(a * b) / gcd(a, b)
end


# --- Factorielle ---
def factorial(n):
    if n <= 1:
        return 1
    end
    mut result = 1
    mut i = 2
    while i <= n:
        result = result * i
        i = i + 1
    end
    return result
end


# --- Fibonacci ---
def fib(n):
    if n <= 0:
        return 0
    end
    if n == 1:
        return 1
    end
    mut a = 0
    mut b = 1
    mut tmp = 0
    mut i = 2
    while i <= n:
        tmp = a + b
        a = b
        b = tmp
        i = i + 1
    end
    return b
end


# --- Moyenne ---
def average(a, b):
    return (a + b) / 2
end


# --- Constante PI ---
def PI():
    return 3.141592653589793
end


# --- Conversion degres <-> radians ---
def degToRad(deg):
    return deg * PI() / 180
end

def radToDeg(rad):
    return rad * 180 / PI()
end