# ==========================================
# Akari Example: FizzBuzz
# ==========================================

mut i = 1

while i <= 15:
    if i % 15 == 0:
        say("FizzBuzz")
    else:
        if i % 3 == 0:
            say("Fizz")
        else:
            if i % 5 == 0:
                say("Buzz")
            else:
                say(toText(i))
            end
        end
    end
    i = i + 1
end