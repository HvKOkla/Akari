let hero = {}
hero.name = "Alice"
hero.hp = 100
hero.max_hp = 100
hero.attack = 15
hero.is_alive = true

let goblin = {}
goblin.name = "Goblin"
goblin.hp = 50
goblin.max_hp = 50
goblin.attack = 10
goblin.is_alive = true

def take_damage(entity, amount):
    entity.hp = entity.hp - amount
    if entity.hp <= 0:
        entity.hp = 0
        entity.is_alive = false
        say(entity.name + " has died.")
    else:
        say(entity.name + " takes " + toText(amount) + " damage. (" + toText(entity.hp) + " HP left)")
    end
end

say("--- BATTLE START ---")
say(hero.name + " attacks!")
take_damage(goblin, 15)
take_damage(goblin, 15)
take_damage(goblin, 15)
take_damage(goblin, 15)
say("--- BATTLE END ---")